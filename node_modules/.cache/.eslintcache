[{"/Users/mansi/folder/portfolio23/src/index.tsx":"1","/Users/mansi/folder/portfolio23/src/App.tsx":"2","/Users/mansi/folder/portfolio23/src/components/About.tsx":"3","/Users/mansi/folder/portfolio23/src/components/Home/Home.tsx":"4","/Users/mansi/folder/portfolio23/src/components/Container/Container.tsx":"5","/Users/mansi/folder/portfolio23/src/components/Navbar/Navbar.tsx":"6"},{"size":367,"mtime":1772812767911,"results":"7","hashOfConfig":"8"},{"size":660,"mtime":1772812767873,"results":"9","hashOfConfig":"8"},{"size":108,"mtime":1772812767908,"results":"10","hashOfConfig":"8"},{"size":12953,"mtime":1772812767910,"results":"11","hashOfConfig":"8"},{"size":916,"mtime":1772812767908,"results":"12","hashOfConfig":"8"},{"size":3447,"mtime":1772812767911,"results":"13","hashOfConfig":"8"},{"filePath":"14","messages":"15","suppressedMessages":"16","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"1lx2pv7",{"filePath":"17","messages":"18","suppressedMessages":"19","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"20"},{"filePath":"21","messages":"22","suppressedMessages":"23","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"24","messages":"25","suppressedMessages":"26","errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"27"},{"filePath":"28","messages":"29","suppressedMessages":"30","errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"31"},{"filePath":"32","messages":"33","suppressedMessages":"34","errorCount":0,"fatalErrorCount":0,"warningCount":9,"fixableErrorCount":0,"fixableWarningCount":5,"source":"35"},"/Users/mansi/folder/portfolio23/src/index.tsx",[],[],"/Users/mansi/folder/portfolio23/src/App.tsx",["36","37","38"],[],"import React from \"react\";\nimport \"./App.css\";\nimport { Routes, Route, Outlet, Link } from \"react-router-dom\";\nimport Container from \"./components/Container/Container\";\nimport Navbar from \"./components/Navbar/Navbar\";\nimport Home from \"./components/Home/Home\";\nimport About from \"./components/About\";\n\nimport { ParallaxProvider } from 'react-scroll-parallax';\nfunction App() {\n  return (\n    <ParallaxProvider>\n      <Routes>\n        <Route path=\"/\" element={<Container />}>\n          <Route index element={<Home />} />\n          <Route path=\"about\" element={<About />} />\n        </Route>\n      </Routes>\n    </ParallaxProvider>\n  );\n}\n\nexport default App;\n\n\n","/Users/mansi/folder/portfolio23/src/components/About.tsx",[],[],"/Users/mansi/folder/portfolio23/src/components/Home/Home.tsx",["39","40","41","42"],[],"import React, { useRef, useEffect } from \"react\";\nimport \"./styles.css\";\nimport { Button, Steps, Divider } from \"antd\";\n\nimport mypicture from \"../../assets/mansi.jpg\";\nimport { Link } from 'react-router-dom';\n\n\n\nimport { ParallaxBanner } from 'react-scroll-parallax';\nimport Rellax from \"rellax\";\n\n\ninterface SectionProps {\n  id?: string;\n}\n\nconst Home = () => {\n  const divRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    const div = divRef.current;\n\n    if (!div) {\n      return;\n    }\n\n    const observer = new IntersectionObserver((entries) => {\n      entries.forEach((entry) => {\n        if (entry.isIntersecting) {\n          div.classList.add(\"fade-in\");\n        } else {\n          div.classList.remove(\"fade-in\");\n        }\n      });\n    });\n\n    observer.observe(div);\n    return () => observer.unobserve(div);\n  }, []);\n\n  useEffect(() => {\n    new Rellax(\".leftimganimate\", { // <---- Via class name\n      speed: 10,\n      center: false,\n      round: true,\n      vertical: true,\n      horizontal: false\n    });\n    new Rellax(\".rightimganimate\", {\n      speed: 3,\n      center: false,\n      round: true,\n      vertical: true,\n      horizontal: false\n    });\n    new Rellax(\".lines\", {\n      speed: 5,\n      center: false,\n      round: true,\n      vertical: true,\n      horizontal: false\n    });\n\n    new Rellax(\".contact\", {\n      speed: -1,\n      center: false,\n      round: true,\n      vertical: true,\n      horizontal: false\n    });\n  }, []);\n\n\n  return (\n    <div className=\"home-wrapper\">\n      <section id=\"home\">\n        <div className=\"intro-section\">\n          <div className=\"left\">\n            <div className=\"side\">\n              <div className=\"name\">Mansi Saini </div>\n            </div>\n            <div className=\"end\"> <a href=\"#contact-me\" className=\"link\"><Button type={\"default\"} size={\"large\"} className=\"hire-me-btn\"> Get in touch</Button> </a></div>\n          </div>\n\n          {/* <div className=\"right\">\n            <div className=\"center\">\n              <div className=\"aboutme\">\n                I'm a Software Engineer based out of Hyderabad, India.\n              </div>\n            </div>\n          </div> */}\n        </div>\n\n        {/* <div className=\"main-links\">\n          <div className=\"view-projects\">\n            <div className=\"round-animated-btn\">Projects</div>\n          </div>\n\n          <div className=\"contact\">nnn\n            <div className=\"round-animated-btn\">About Me</div>\n          </div>\n        </div> */}\n      </section>\n\n      <section id=\"about-me\">\n        <br />\n        {/* <div className=\"aboutme-title\">About me</div> */}\n        <div className=\"about-me-section\">\n          <div className=\"aboutme-bottom\">\n            <div className=\"aboutme-details\">\n              I'm a Software Engineer based out of Hyderabad, India.\n              <div className=\"details\">\n                <div className=\"exp\">\n                  <div className=\"experience-title\">Experience</div>\n                  <Steps\n                    className=\"steps\"\n                    progressDot\n                    current={5}\n                    direction=\"vertical\"\n                    items={[\n                      {\n                        title: <div style={{ zIndex: 10 }}>Skit.ai</div>,\n                        description: (\n                          <div>\n                            Software Engineer - <em>Bengaluru,India</em>\n                          </div>\n                        ),\n                      },\n                      {\n                        title: <div style={{ zIndex: 10 }}>Adqura</div>,\n                        description: (\n                          <div>\n                            Software Engineer - <em>Hyderabad,India</em>\n                          </div>\n                        ),\n                      },\n                      {\n                        title: <div>True Beacon</div>,\n                        description: (\n                          <div>\n                            Full Stack Engineering Intern - <em>Banglore,India</em>\n                          </div>\n                        ),\n                      },\n\n                    ]}\n                  />\n\n\n\n\n\n                </div>\n\n                <div className=\"edu\">\n                  <div className=\"experience-title\">Education</div>\n                  <Steps\n                    progressDot\n                    current={5}\n                    direction=\"vertical\"\n                    items={[\n                      {\n                        title: (\n                          <div>\n                            Jawaharlal Nehru Technological University, Hyderabad\n                          </div>\n                        ),\n                        description: (\n                          <div>\n                            2019-2023 <br />\n                            Bachelor's of Technology -{\" \"}\n                            <em>Electronics and Communication Engineering</em>\n                          </div>\n                        ),\n                      },\n                    ]}\n                  />\n\n                </div>\n              </div>\n              <div style={{ fontSize: \"0.9rem\" }}>\n                Throughout college I focused on modern web technologies like React, NodeJs and Serverless computing etc.Most of my projects are in MERN Stack with occasional GoLang or Python backend API's. However I love to deep dive into classic technologies, languages and most importantly the concepts. I like to develop mini games for fun,When I'm not developing I try to enhance my problem solving abilities by solving DSA problems. <br /> <br />\n                I try to frquently post at my <a href=\"https://blogmansi.vercel.app/\" style={{ color: \"rgb(191, 165, 255)\" }}>Blog</a>, rather than a place to give advice, Its more of me documenting my learning process in software industry {\":')\"} <br />\n                This entire portfolio was built by me from scratch using React and Typescript. <br />\n                If you want to collaborate or discuss anything, feel free to  <a href=\"#contact-me\" style={{ color: \"rgb(191, 165, 255)\" }}>get in touch</a> with me.\n                <br />\n                <br />\n                Below you will find some of my personal projects I built.\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n\n\n\n\n\n      {/* <div className=\"image leftimganimate\">\n              <img src={mypicture} className=\"img-si\" />\n            </div> */}\n\n      <section id=\"projects-sec\">\n        <div className=\"main\">\n          <div className=\"projects\">\n            <div className=\"experience-title\">Projects </div>\n            <div className=\"experience-title\" style={{ fontSize: \"1.2rem\" }}>Games/Interactive </div>\n\n            <Link to=\"https://drawnote.gameyy.online/\" target=\"_blank\">\n              <div className=\"project\">\n                <div className=\"project-details\">\n                  <div className=\"heading\">Drawnote</div>\n                  <div className=\"description\">\n                    Notemaking/Virtual whiteboard/drawing app, it supports adding texts, images, PDF’s\n                    <br />\n                    Zoom, pan, pinch the board as well as make notes, drawings, hand- drawn sketches.\n                    <br /> <a href=\"https://drawnote.gameyy.online/\" style={{ color: \"white\" }}>Click Here</a> to preview. <br />\n                    <a href=\"https://github.com/mansi-done/drawnote\" style={{ color: \"white\" }}>Click Here</a> for GitHub\n                    <br />\n                    <a href=\"https://www.youtube.com/watch?v=Dirp0JvdNqo\" style={{ color: \"white\" }}>Click Here</a> a Demo\n\n                  </div>\n                </div>\n                <div className=\"scroll-image-dr\"></div>\n              </div>\n            </Link>\n\n\n\n\n\n            <Link to=\"https://unscramble.gameyy.online/\" target=\"_blank\">\n              <div className=\"project\">\n                <div className=\"scroll-image-un\"></div>\n\n\n                <div className=\"project-details\">\n                  <div className=\"heading\">Unscramble</div>\n                  <div className=\"description\">\n                    Fun word game to Unscramble jumbled words <br />\n                    Made by using React and Typescript\n                    <br />\n                    <a href=\"https://unscramble.gameyy.online/\" style={{ color: \"white\" }}>Click Here </a>to preview.\n                  </div>\n                </div>\n              </div>\n\n            </Link>\n\n\n            <Link to=\"https://tictactoe.gameyy.online/\" target=\"_blank\">\n              <div className=\"project\">\n                <div className=\"project-details\">\n                  <div className=\"heading\">Real-time Tic Tac Toe</div>\n                  <div className=\"description\">\n                    Real time scalable Tic Tac Toe app to play with friends.{\" \"}\n                    <br />\n                    Includes real time gameplay and live chat. Backend API built\n                    with ExpressJS using Socket.io Frontend Built on ReactJS with\n                    TypeScript.\n                    <br />\n                    <br /> <a href=\"https://tictactoe.gameyy.online/\" style={{ color: \"white\" }}>Click Here</a> to preview. <br />\n                    <a href=\"https://github.com/mansi-done/tictactoe-api-with-sockets\" style={{ color: \"white\" }}>Click Here</a> for backend  GitHub <br /><a href=\"https://github.com/mansi-done/tictactoe-frontend\" style={{ color: \"white\" }}> Click Here </a> for front end\n                    GitHub\n                  </div>\n                </div>\n                <div className=\"scroll-image-ti\"></div>\n              </div>\n            </Link>\n\n\n            <div className=\"experience-title\" style={{ fontSize: \"1.2rem\" }}>Frontend </div>\n\n\n            <Link to=\"https://cryptoden.netlify.app/\" target=\"_blank\">\n              <div className=\"project\">\n                <div className=\"scroll-image-cr\" ></div>\n\n                <div className=\"project-details\">\n                  <div className=\"heading\">CryptoDen</div>\n                  <div className=\"description\">\n                    A Cryptocurrency React Web Application with LIVE Crypto Data,\n                    it provides Latest In-depth data about all Cryptocurrencies,\n                    Statistics, News, Market Patterns et cetera. Built by ReactJS,\n                    using Redux Tool Kit for API integration. <br />\n                    <br />\n                    <a href=\"https://cryptoden.netlify.app/\" style={{ color: \"white\" }}>Click Here </a>to preview.\n                  </div>\n                </div>\n              </div>\n\n            </Link>\n\n\n\n            <div className=\"experience-title\" style={{ fontSize: \"1.2rem\" }}>API's/Backend </div>\n\n            <Link to=\"https://rapidapi.com/mansisaini01/api/amazon-india-data-scrapper/\" target=\"_blank\">\n\n\n              <div className=\"project\">\n                <div className=\"project-details\">\n                  <div className=\"heading\">Web Scrapper for Amazon India API</div>\n                  <div className=\"description\">\n                    {\" \"}\n                    API that returns LIVE product listings for amazon search\n                    queries and complete in-depth product details to use in amazon\n                    clones or just analysis. <br />\n                    Build by Node JS using Express JS server (API on RapidAPI){\" \"}\n                    <br /> <br /> <a href=\"https://rapidapi.com/mansisaini01/api/amazon-india-data-scrapper/\" style={{ color: \"white\" }}> Click Here </a> to preview.\n                  </div>\n                </div>\n              </div>\n            </Link>\n\n            <Link to=\"https://blogmansi.vercel.app/post/scalable-tic-tac-toe-api\" target=\"_blank\">\n\n              <div className=\"project\">\n                <div className=\"project-details\">\n                  <div className=\"heading\">Scalable TicTacToe API</div>\n                  <div className=\"description\">\n                    API to play Tic Tac Toe with n*n board. Build by Node JS using\n                    Express JS server.\n                    <br />\n                    <br /><a href=\"https://blogmansi.vercel.app/post/scalable-tic-tac-toe-api\" style={{ color: \"white\" }}> Click Here </a> to preview.\n                  </div>\n                </div>\n              </div>\n\n            </Link>\n\n\n\n          </div>\n        </div>\n      </section>\n\n      <section id=\"contact-me\">\n        <div className=\"contact-wrapper\">\n          <div className=\"contact-title\">Contact</div>\n          <div className=\"con-details\">\n            <div className=\"named\">\n              Name : Mansi Saini\n            </div>\n            <div className=\"mail\"> Mail : mansi.saini01@gmail.com</div>\n            {/* <div className=\"contactnum\">\n              Phone :  +91 8106721687\n            </div> */}\n\n          </div>\n\n\n\n        </div>\n      </section>\n    </div>\n  );\n};\n\nexport default Home;\n","/Users/mansi/folder/portfolio23/src/components/Container/Container.tsx",["43","44","45","46","47","48"],[],"import React from \"react\";\nimport { Link, Outlet } from \"react-router-dom\";\nimport Navbar from \"../Navbar/Navbar\";\nimport Sidebar from \"../Sidebar/Sidebar\";\nimport TaskBar from \"../TaskBar/TaskBar\";\nimport Desktop from \"../Desktop/Desktop\";\nimport \"./styles.css\";\nimport { ConfigProvider, theme, Button } from \"antd\";\n\nimport mybg from \"../../assets/twinkling.png\"\nconst Container = () => {\n  return (\n    <div className=\"container\">\n      <img id=\"bgimg\" src={mybg} alt=\"Background Image\"/>\n      <ConfigProvider\n        theme={{\n          algorithm: theme.darkAlgorithm,\n          token: {\n            colorPrimary: \"#9782DE\",\n          },\n        }}\n      >\n        {/* <TaskBar/>\n        <div className=\"win\">\n          <Outlet/>\n        </div>\n        <Desktop/> */}\n        <Navbar />\n        <Outlet />\n        \n        {/* <Sidebar/> */}\n      </ConfigProvider>\n    </div>\n  );\n};\n\nexport default Container;\n","/Users/mansi/folder/portfolio23/src/components/Navbar/Navbar.tsx",["49","50","51","52","53","54","55","56","57"],[],"import React, { useState, useEffect } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport \"./styles.css\";\nimport { Button } from \"antd\";\nimport { MenuOutlined } from '@ant-design/icons';\n\nimport {\n  LinkedinOutlined,\n  GithubOutlined,\n  MailOutlined,\n  MediumWorkmarkOutlined,\n} from \"@ant-design/icons\";\n\nconst NavContent = () => {\n  return (\n    <div className=\"navcontent\">\n      <div className=\"nav\">\n        <ul className=\"nav-list\">\n          <li>\n            <a href=\"#home\" className=\"link\">\n              Home\n            </a>\n          </li>\n          <li>\n            <a href=\"#about-me\" className=\"link\">\n              About\n            </a>\n          </li>\n          <li>\n            <a href=\"#projects-sec\" className=\"link\">\n              Projects\n            </a>\n          </li>\n          <li>\n            <a\n              target=\"_blank\"\n              href=\"https://blogmansi.vercel.app/\"\n              className=\"link\"\n            >\n              Blog\n            </a>\n          </li>\n          <li>\n            <a\n              target=\"_blank\"\n              href=\"https://drive.google.com/file/d/1-2uNmZp99_Cn5TE8FFAV4mFW9l9C_x3J/view\"\n              className=\"link\"\n            >\n              Resume\n            </a>\n          </li>\n\n          <li>\n            <a href=\"#contact-me\" className=\"link\">\n              Contact\n            </a>\n          </li>\n        </ul>\n      </div>\n\n      <div className=\"links-wrapper\">\n        <ul className=\"links-list\">\n          <li>\n            <a\n              target=\"_blank\"\n              href=\"https://www.linkedin.com/in/mansi-saini-096323154/\"\n              className=\"contact-link\"\n            >\n              {\" \"}\n              <LinkedinOutlined />\n            </a>\n          </li>\n          <li>\n            <a\n              target=\"_blank\"\n              href=\"https://github.com/mansi-done\"\n              className=\"contact-link\"\n            >\n              <GithubOutlined />\n            </a>\n          </li>\n\n          <li>\n            <a\n              target=\"_blank\"\n              href=\"https://medium.com/@mansi.saini01\"\n              className=\"contact-link\"\n            >\n              {\" \"}\n              <MediumWorkmarkOutlined />\n            </a>\n          </li>\n\n          <li>\n            <a\n              href=\"mailto:mansi.saini01@gmail.com\"\n              className=\"contact-link\"\n            >\n              <MailOutlined />\n            </a>\n          </li>\n        </ul>\n      </div>\n    </div>\n  )\n}\n\nconst Navbar = () => {\n  // const mediaQuery = window.matchMedia(\"(max-width: 700px)\");\n  const [phoneRes, setPhoneRes] = useState(window.matchMedia(\"(max-width: 700px)\").matches);\n  const [navOpen, setNavOpen] = useState(false)\n\n  useEffect(() => {\n    const mediaQuery = window.matchMedia(\"(max-width: 700px)\");\n    const handleMediaQueryChange = (mq: any) => {\n      setPhoneRes(mq.matches);\n    };\n    // Add the media query listener to directly check the matches property\n    mediaQuery.addEventListener(\"change\", handleMediaQueryChange);\n\n    // Clean up the media query listener when the component unmounts\n    return () => {\n      mediaQuery.removeEventListener(\"change\", handleMediaQueryChange);\n    };\n  }, []);\n\n  const handleNavOpen = () => {\n    navOpen ? setNavOpen(false) : setNavOpen(true)\n  }\n\n  return (\n    <div className=\"navbar-wrapper\">\n      {!phoneRes && (<NavContent />\n      )}\n    </div>\n  );\n};\n\nexport default Navbar;\n",{"ruleId":"58","severity":1,"message":"59","line":3,"column":25,"nodeType":"60","messageId":"61","endLine":3,"endColumn":31},{"ruleId":"58","severity":1,"message":"62","line":3,"column":33,"nodeType":"60","messageId":"61","endLine":3,"endColumn":37},{"ruleId":"58","severity":1,"message":"63","line":5,"column":8,"nodeType":"60","messageId":"61","endLine":5,"endColumn":14},{"ruleId":"58","severity":1,"message":"64","line":3,"column":25,"nodeType":"60","messageId":"61","endLine":3,"endColumn":32},{"ruleId":"58","severity":1,"message":"65","line":5,"column":8,"nodeType":"60","messageId":"61","endLine":5,"endColumn":17},{"ruleId":"58","severity":1,"message":"66","line":10,"column":10,"nodeType":"60","messageId":"61","endLine":10,"endColumn":24},{"ruleId":"58","severity":1,"message":"67","line":14,"column":11,"nodeType":"60","messageId":"61","endLine":14,"endColumn":23},{"ruleId":"58","severity":1,"message":"62","line":2,"column":10,"nodeType":"60","messageId":"61","endLine":2,"endColumn":14},{"ruleId":"58","severity":1,"message":"68","line":4,"column":8,"nodeType":"60","messageId":"61","endLine":4,"endColumn":15},{"ruleId":"58","severity":1,"message":"69","line":5,"column":8,"nodeType":"60","messageId":"61","endLine":5,"endColumn":15},{"ruleId":"58","severity":1,"message":"70","line":6,"column":8,"nodeType":"60","messageId":"61","endLine":6,"endColumn":15},{"ruleId":"58","severity":1,"message":"71","line":8,"column":33,"nodeType":"60","messageId":"61","endLine":8,"endColumn":39},{"ruleId":"72","severity":1,"message":"73","line":14,"column":7,"nodeType":"74","endLine":14,"endColumn":58},{"ruleId":"58","severity":1,"message":"62","line":2,"column":10,"nodeType":"60","messageId":"61","endLine":2,"endColumn":14},{"ruleId":"58","severity":1,"message":"71","line":4,"column":10,"nodeType":"60","messageId":"61","endLine":4,"endColumn":16},{"ruleId":"58","severity":1,"message":"75","line":5,"column":10,"nodeType":"60","messageId":"61","endLine":5,"endColumn":22},{"ruleId":"76","severity":1,"message":"77","line":35,"column":13,"nodeType":"74","messageId":"78","endLine":39,"endColumn":14,"fix":"79"},{"ruleId":"76","severity":1,"message":"77","line":44,"column":13,"nodeType":"74","messageId":"78","endLine":48,"endColumn":14,"fix":"80"},{"ruleId":"76","severity":1,"message":"77","line":64,"column":13,"nodeType":"74","messageId":"78","endLine":68,"endColumn":14,"fix":"81"},{"ruleId":"76","severity":1,"message":"77","line":74,"column":13,"nodeType":"74","messageId":"78","endLine":78,"endColumn":14,"fix":"82"},{"ruleId":"76","severity":1,"message":"77","line":84,"column":13,"nodeType":"74","messageId":"78","endLine":88,"endColumn":14,"fix":"83"},{"ruleId":"58","severity":1,"message":"84","line":127,"column":9,"nodeType":"60","messageId":"61","endLine":127,"endColumn":22},"@typescript-eslint/no-unused-vars","'Outlet' is defined but never used.","Identifier","unusedVar","'Link' is defined but never used.","'Navbar' is defined but never used.","'Divider' is defined but never used.","'mypicture' is defined but never used.","'ParallaxBanner' is defined but never used.","'SectionProps' is defined but never used.","'Sidebar' is defined but never used.","'TaskBar' is defined but never used.","'Desktop' is defined but never used.","'Button' is defined but never used.","jsx-a11y/img-redundant-alt","Redundant alt attribute. Screen-readers already announce `img` tags as an image. You don’t need to use the words `image`, `photo,` or `picture` (or any specified custom words) in the alt prop.","JSXOpeningElement","'MenuOutlined' is defined but never used.","react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" (which implies rel=\"noopener\") is a security risk in older browsers: see https://mathiasbynens.github.io/rel-noopener/#recommendations","noTargetBlankWithoutNoreferrer",{"range":"85","text":"86"},{"range":"87","text":"86"},{"range":"88","text":"86"},{"range":"89","text":"86"},{"range":"90","text":"86"},"'handleNavOpen' is assigned a value but never used.",[946,946]," rel=\"noreferrer\"",[1195,1195],[1659,1659],[1911,1911],[2146,2146]]